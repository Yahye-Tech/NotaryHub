# Public/runtime configuration
APP_URL="http://localhost:3000"
PORT="3000"
NODE_ENV="development"

# PostgreSQL
DATABASE_URL="postgresql://notaryhub:CHANGE_ME@localhost:5432/notaryhub"

# Authentication secrets — generate unique values for every deployment
JWT_ACCESS_SECRET="CHANGE_ME_access_secret"
JWT_REFRESH_SECRET="CHANGE_ME_refresh_secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Upload storage — local disk by default (fine for a single, persistent
# server; not fine for most cloud hosting, which wipes the filesystem on
# every redeploy). Set STORAGE_S3_BUCKET to switch to S3-compatible storage
# (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO) instead.
UPLOAD_DIR="./uploads"
# STORAGE_S3_BUCKET="my-notaryhub-uploads"
# STORAGE_S3_REGION="us-east-1"
# STORAGE_S3_ENDPOINT=""                      # only needed for non-AWS providers (R2, Spaces, MinIO)
# STORAGE_S3_ACCESS_KEY_ID="CHANGE_ME"
# STORAGE_S3_SECRET_ACCESS_KEY="CHANGE_ME"
# STORAGE_S3_FORCE_PATH_STYLE="false"         # set "true" for MinIO/most non-AWS providers

# Reverse proxy trust — defaults to trusting exactly one hop (correct for the
# overwhelming majority of single-proxy deployments: nginx, Cloud Run,
# Render, Railway, etc.). Set to "false" if running with no proxy in front
# (so req.ip can't be spoofed via headers), or to a specific count/IP
# range/"loopback" if your topology has more hops.
TRUST_PROXY="1"

# Optional AI integration
GEMINI_API_KEY=""

# SMTP fallback configuration. SUPER_ADMIN can persist host/port/user/TLS
# through Platform Settings; the password must remain in deployment secrets.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="mailer@example.com"
SMTP_SECURE="true"
SMTP_PASS="CHANGE_ME_SMTP_PASSWORD"
EMAIL_FROM="NotaryHub <no-reply@example.com>"

# Optional security/application settings
BCRYPT_ROUNDS="12"
TOTP_ISSUER="NotaryHub"
